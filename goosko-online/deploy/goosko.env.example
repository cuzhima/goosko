# Скопировать в /etc/goosko/goosko.env и заполнить реальными значениями.
# chmod 600, владелец — root:goosko. НЕ коммитить настоящий файл!

# Обязательное: длинная случайная строка (openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Только при самой первой инициализации БД (потом можно удалить).
# Если не задан — пароль admin выводится один раз в лог журнала.
#ADMIN_PASSWORD=

# Пути (совпадают с дефолтами приложения)
STORAGE_DIR=/var/www/storage
DB_PATH=/opt/goosko-online/users.db
MEDIA_DIR=/var/www/storage/media

# Адреса сайта
PUBLIC_BASE_URL=https://goosko.online
FUNNEL_HOST=https://andrey-monoblock.tail098776.ts.net

# Отдача файлов через nginx (X-Accel-Redirect). 0 — отдаёт сам Flask.
USE_X_ACCEL=1

# Лимиты хранилища
MAX_FILE_SIZE=4294967296
USER_QUOTA=21474836480
UPLOAD_TOKEN_TTL=3600
SHARE_TTL_HOURS=24
TRASH_RETENTION_DAYS=30

# Быстрый доступ (камера/скриншоты)
CAMERA_DEVICE=/dev/video0
CAMERA_RESOLUTION=1280x720
SCREEN_DEVICE=:1.0+0,0
WAYLAND_DISPLAY_ENV=wayland-0
FFMPEG_TIMEOUT=30
CAMERA_PHOTO_TTL=86400
CAMERA_VIDEO_MAX_SECONDS=120

# SSH-сертификаты
SSH_PRINCIPAL=andrey
SSH_HOST_HINT=andrey-monoblock.tail098776.ts.net
SSH_PORT=10000
