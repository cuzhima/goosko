#!/usr/bin/env bash
# Временный канал для БОЛЬШИХ ЗАГРУЗОК: funnel только для /upload-big/, авто-выключение.
# Использование: goosko-funnel start|stop|status
set -euo pipefail

STATE_FILE=/run/goosko/funnel
AUTOOFF_MIN=${GOOSKO_FUNNEL_TTL:-45}

funnel_url() {
    # FQDN узла из tailscale status (Self.DNSName)
    tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    dns = ((d.get("Self") or {}).get("DNSName") or "").strip(".")
    print(f"https://{dns}" if dns else "")
except Exception:
    pass
'
}

write_state() {
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$1" > "$STATE_FILE"
    chmod 644 "$STATE_FILE"
}

prepare_autooff_timer() {
    systemctl stop goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true
    systemctl reset-failed goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true
    systemd-run --on-active="${AUTOOFF_MIN}min" --unit=goosko-funnel-autooff \
        /usr/local/sbin/goosko-funnel stop >/dev/null
}

case "${1:-}" in
    start)
        URL=$(funnel_url)
        if [ -z "$URL" ]; then
            echo "Не удалось определить funnel-домен (tailscale не запущен?)"
            exit 1
        fi

        if ! tailscale funnel --bg --https 443 --set-path /upload-big/ http://127.0.0.1:5000/upload-big/; then
            echo "tailscale funnel не включился"
            exit 1
        fi

        prepare_autooff_timer
        write_state "on ${URL}"
        echo "Канал включён: ${URL}/upload-big/ (авто-выключение через ${AUTOOFF_MIN} мин)"
        ;;
    stop)
        tailscale funnel reset >/dev/null 2>&1 || true
        systemctl stop goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true
        systemctl reset-failed goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true
        write_state "off"
        echo "Канал выключен"
        ;;
    status)
        if [ -r "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        else
            echo off
        fi
        ;;
    *)
        echo "Использование: goosko-funnel start|stop|status" >&2
        exit 2
        ;;
esac
