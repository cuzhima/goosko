#!/usr/bin/env bash
# Tailscale Funnel (ts.net): ПОСТОЯННЫЙ канал — весь сайт.
# Включение: tailscale funnel для / (Angie 127.0.0.1:80) без авто-выключения.
# Выключение: tailscale funnel reset (канал полностью снимается).
# Использование: goosko-funnel start|stop|status
set -euo pipefail

STATE_FILE=/run/goosko/funnel

funnel_url() {
    # FQDN узла из tailscale status (Self.DNSName)
    tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    dns = ((d.get("Self") or {}).get("DNSName") or "").strip(".")
    print(f"https://{dns}" if dns else "")
except Exception:
    pass
'
}

write_state() {
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$1" > "$STATE_FILE"
    chmod 644 "$STATE_FILE"
}

case "${1:-}" in
    start)
        URL=$(funnel_url)
        if [ -z "$URL" ]; then
            echo "Не удалось определить funnel-домен (tailscale не запущен?)"
            exit 1
        fi

        if ! tailscale funnel --bg --https 443 http://127.0.0.1:80; then
            echo "tailscale funnel не включился"
            exit 1
        fi
        # На случай, если остался старый 45-минутный таймер — убираем.
        systemctl stop goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true
        systemctl reset-failed goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true

        write_state "on ${URL}"
        echo "Канал включён (постоянно): ${URL}/"
        ;;
    stop)
        tailscale funnel reset >/dev/null 2>&1 || true
        systemctl stop goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true
        systemctl reset-failed goosko-funnel-autooff.timer goosko-funnel-autooff.service 2>/dev/null || true
        write_state "off"
        echo "Канал выключен"
        ;;
    status)
        # State-файл живёт в tmpfs; после ребута перепроверяем факт через tailscale.
        if [ -r "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        elif tailscale serve status 2>/dev/null | grep -q "Funnel on"; then
            URL=$(funnel_url)
            if [ -n "$URL" ]; then
                write_state "on ${URL}"
                cat "$STATE_FILE"
            else
                echo on
            fi
        else
            echo off
        fi
        ;;
    *)
        echo "Использование: goosko-funnel start|stop|status" >&2
        exit 2
        ;;
esac
